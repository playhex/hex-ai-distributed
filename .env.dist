# Engine run by this worker: katahex, mohex or davies.
# Run multiple workers to run multiple engines.
ENGINE=katahex

# Job types to process, comma separated.
# Empty: default job types of the engine, i.e for katahex:
#   katahex-intuition-move, katahex-intuition-analyze-position, katahex-intuition-analyze-game
# Tree search job types (katahex-mcts-*) require more computing power, and are processed only when explicitly set:
#   AI_JOB_TYPES=katahex-intuition-move,katahex-mcts-move,katahex-intuition-analyze-position,katahex-mcts-analyze-position,katahex-intuition-analyze-game,katahex-mcts-analyze-move
# Mohex solver (puzzles check) is processed only when explicitly set:
#   AI_JOB_TYPES=mohex-solve-position
AI_JOB_TYPES=

# PlayHex server to pull AI jobs from, i.e https://playhex.org, or http://localhost:3000
HEX_URL=http://localhost:3000

# Key given by PlayHex admins, created with (in hex repo):
#   pnpm hex ai-worker-key:create <player id or slug>
AI_WORKER_KEY=

# Command to run Mohex engine, required when ENGINE=mohex
MOHEX_BIN="/bin/mohex --seed 1"

# Threads used by Mohex solver (mohex-solve-position jobs), defaults to 1
MOHEX_SOLVER_THREADS=

# Command to run Katahex engine, required when ENGINE=katahex
# Download this Katahex model here: https://drive.google.com/file/d/1xMvP_75xgo0271nQbmlAJ40rvpKiFTgP/view
# See other models list: https://www.hexwiki.net/index.php/KataHex#Links
KATAHEX_BIN="/bin/katahex gtp -config ./katahex/config.cfg -model ./katahex/katahex_model_20220618.bin.gz"

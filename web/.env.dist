# Copy to .env to use a local PlayHex with pnpm dev. Not read by pnpm build:playhex, see .env.playhex.prod.
VITE_PLAYHEX_URL=http://localhost:13000
VITE_OAUTH_CLIENT_ID=hex-web-worker
VITE_MODEL_URL=http://localhost:13000/katahex-models/hex27x3.fp16.onnx
VITE_MODEL_URL_FLOAT32=http://localhost:13000/katahex-models/hex27x3.onnx
VITE_KATAHEX_MODEL_URL=http://localhost:13000/katahex-models/hex27x3.bin.gz

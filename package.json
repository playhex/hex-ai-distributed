{
  "name": "hex-ai-distributed",
  "version": "1.0.0",
  "description": "Hex AI workers. Pull AI jobs (bot moves, game analyzes) from PlayHex and process them with Katahex, Mohex or Davies.",
  "author": "Julien Maulny",
  "license": "AGPL-3.0",
  "scripts": {
    "test": "mocha src/**/test/**/*.ts -n import=ts-node/esm --extension ts",
    "worker": "nodemon src/worker/index.ts",
    "build": "rm -fr dist/ && tsc && cp .env* dist/",
    "prepare": "ts-patch install && typia patch"
  },
  "dependencies": {
    "davies-hex-ai": "^1.2.7",
    "dotenv": "^16.3.1",
    "p-queue": "<=6.6.2",
    "typia": "^5.3.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "22",
    "mocha": "^10.3.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.1.2",
    "typescript": "^5.3.3"
  }
}
